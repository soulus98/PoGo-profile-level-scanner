{
  "name": "ocrboi",
  "version": "3.0.0",
  "description": "Pokémon go Trainer Profile OCR developed for the Pokémon GO Raids discord server",
  "main": "bot.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node bot.js",
    "dev": "nodemon bot.js",
    "register-commands": "node scripts/register-commands.js",
    "check": "eslint --ignore-pattern node_modules . && node scripts/validate-intents.js && node scripts/validate-commands.js",
    "test": "npm run check"
  },
  "nodemonConfig": {
    "ignore": [
      "misc/*",
      "*.json"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soulus98/ocrbot.git"
  },
  "author": "Soul Green",
  "license": "Unlicenced",
  "private": true,
  "bugs": {
    "url": "https://github.com/soulus98/ocrbot/issues"
  },
  "homepage": "https://github.com/soulus98/ocrbot#readme",
  "dependencies": {
    "discord.js": "^14.27.0",
    "gm": "^1.23.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "eslint": "^7.32.0",
    "nodemon": "^3.1.14"
  }
}
